datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum NodeOrigin {
  REGISTRATION // สมัครสมาชิกปกติ
  BATCH        // สมัครแบบกลุ่ม (Batch)
  CLONE        // โคลนอัตโนมัติจากฝั่งขวา (Rebirth)
  AUTO_MAIN    // ไอดีหลักใหม่จาก Vault Rank 1-4
  AUTO_EXTRA   // Extra ID จาก Vault Rank 4-MAX
}

enum RewardType {
  DIRECT
  LEVEL
  UPGRADE_VAULT
  VAULT_OVERFLOW
  ALLSELL
  BOT
  FAMILY_POOL_OVERFLOW
}

model UserAccount {
  id                String   @id @default(uuid())
  owner             String   @unique // แอดเดรสกระเป๋าผู้ใช้
  sponsor           String?  // แอดเดรสผู้แนะนำ
  sponsorMainNodeId BigInt?  // ID โหนดหลักของผู้แนะนำ
  currentMaxRank    Int      @default(1) // แรงค์สูงสุดที่ผู้ใช้ถือครอง
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vaults            UserVault[]

  @@index([owner])
}

model UserVault {
  id            String      @id @default(uuid())
  owner         String      // แอดเดรสกระเป๋าผู้ใช้
  rank          Int         // แรงค์ (1-27)
  balance       Decimal     @default(0) @db.Decimal(36, 18) // ยอดเงินสะสมใน Vault (USDT)
  updatedAt     DateTime    @updatedAt

  user          UserAccount @relation(fields: [owner], references: [owner], onDelete: Cascade)

  @@unique([owner, rank])
  @@index([owner])
}

model MatrixNode {
  id            BigInt     @id // nodeId บน Smart Contract
  rank          Int        // แรงค์ของโหนด (1-27)
  owner         String     // แอดเดรสเจ้าของโหนด
  sponsor       String     // แอดเดรสผู้แนะนำตรง
  parentId      BigInt     // ID ของโหนดพ่อแม่
  leftChild     BigInt     @default(0) // ID โหนดลูกซ้าย
  rightChild    BigInt     @default(0) // ID โหนดลูกขวา
  isClone       Boolean    @default(false) // เป็นโหนดโคลนหรือไม่
  isExtraId     Boolean    @default(false) // เป็น Extra ID หรือไม่
  origin        NodeOrigin @default(REGISTRATION) // ที่มาของโหนด
  createdAt     DateTime   @default(now())

  @@index([rank])
  @@index([owner])
  @@index([parentId])
}

model RewardLog {
  id          String     @id @default(uuid())
  fromNodeId  BigInt     // ID โหนดที่สร้างรายได้
  toNodeId    BigInt     // ID โหนดผู้รับรางวัล
  recipient   String     // แอดเดรสกระเป๋าผู้รับ
  rank        Int        // แรงค์ที่เกิดรายการ
  rewardType  RewardType // ประเภทของรางวัล
  amount      Decimal    @db.Decimal(36, 18) // จำนวนเงิน (USDT)
  txHash      String     // Hash ธุรกรรมบนบล็อกเชน
  createdAt   DateTime   @default(now())

  @@index([recipient])
  @@index([rank])
}

model AllSellAutoConfig {
  id                   String   @id @default("default")
  autoEnabled          Boolean  @default(true) @map("auto_enabled")
  lastExecutedCycleKey String?  @map("last_executed_cycle_key")
  lastExecutedAt       String?  @map("last_executed_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("allsell_auto_config")
}

model AllSellPayoutCycle {
  id                       String                  @id
  contractAddress          String                  @map("contract_address")
  cycleKey                 String                  @map("cycle_key")
  cycleLabelTh             String                  @map("cycle_label_th")
  triggerType              String                  @map("trigger_type")
  executedAt               String                  @map("executed_at")
  totalAllSellPoolUsdt     Decimal                 @default(0) @map("total_allsell_pool_usdt") @db.Decimal(20, 6)
  totalDistributedUsdt     Decimal                 @default(0) @map("total_distributed_usdt") @db.Decimal(20, 6)
  carriedOverUsdt          Decimal                 @default(0) @map("carried_over_usdt") @db.Decimal(20, 6)
  qualifiedRecipientsCount Int                     @default(0) @map("qualified_recipients_count")
  transfers                Json                    @default("[]")
  noteTh                   String?                 @map("note_th")
  createdAt                DateTime                @default(now()) @map("created_at")

  @@index([contractAddress])
  @@index([executedAt])
  @@map("allsell_payout_cycles")
}

model AllSellPayoutTransfer {
  id              String   @id
  cycleId         String   @map("cycle_id")
  contractAddress String   @map("contract_address")
  cycleKey        String   @map("cycle_key")
  poolNumber      Int      @map("pool_number")
  poolTitleTh     String   @map("pool_title_th")
  mainId          Int      @map("main_id")
  recipientWallet String   @map("recipient_wallet")
  amountUsdt      Decimal  @map("amount_usdt") @db.Decimal(20, 6)
  txHash          String   @map("tx_hash")
  mode            String
  executedAt      String   @map("executed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([cycleId])
  @@index([contractAddress])
  @@index([recipientWallet])
  @@map("allsell_payout_transfers")
}

model AllSellInflow {
  id              String   @id
  contractAddress String   @map("contract_address")
  rank            Int
  fromNodeId      Int      @map("from_node_id")
  fromMainId      Int      @map("from_main_id")
  fromNodeType    String   @map("from_node_type")
  parentId        Int      @map("parent_id")
  amountUsdt      Decimal  @map("amount_usdt") @db.Decimal(20, 6)
  recipient       String
  note            String
  txHash          String?  @map("tx_hash")
  blockNumber     BigInt?  @map("block_number")
  eventTime       String   @map("event_time")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([contractAddress])
  @@index([rank])
  @@map("allsell_inflows")
}

