# WebSocket RPC URL สำหรับดักฟัง Event แบบเรียลไทม์ (BSC Testnet PublicNode ฟรีและเสถียร)
WSS_URL=wss://bsc-testnet-rpc.publicnode.com

# HTTP RPC URL สำรองสำหรับการส่ง Transaction ที่เสถียรและไม่หลุดกลางคัน
HTTP_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Private Key ของกระเป๋าบอทที่ใช้จ่ายค่า Gas
BOT_PRIVATE_KEY=

# ตั้งค่า Exponential Backoff (หน่วยเป็นมิลลิวินาที)
INITIAL_RECONNECT_DELAY_MS=2000
MAX_RECONNECT_DELAY_MS=60000
HEARTBEAT_INTERVAL_MS=30000